<?xml version="1.0" encoding="utf-8"?>
<!-- 
    极简精美台词卡片 (item_script_draft.xml)
    轻量紧凑布局，标题与日期横向对称，底部数据标签与操作按钮紧凑排布
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_script_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#1A1C24"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#26FFFFFF"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- 标题 (左侧加粗白字) -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="台词标题"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tv_date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 日期时间 (右上角横向排布，不挤占底部标签) -->
        <TextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:text="2024.04.12 15:30"
            android:textColor="#66FFFFFF"
            android:textSize="11sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_title"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 2行台词正文精要 (去繁化简，卡片高度大幅降低) -->
        <TextView
            android:id="@+id/tv_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:text="台词正文摘要预览，最多显示两行内容..."
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />

        <!-- 底部左侧：时长与字数标签 (纯横向排列，不换行) -->
        <LinearLayout
            android:id="@+id/ll_tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_preview">

            <TextView
                android:id="@+id/tv_duration_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_pill"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="⏱ 45 秒"
                android:textColor="#38EF7D"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_words_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tag_pill"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="180 字"
                android:textColor="#80FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 底部右侧：全屏、删除、悬浮开播 -->
        <LinearLayout
            android:id="@+id/ll_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/ll_tags"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ll_tags">

            <!-- 删除按钮 -->
            <ImageView
                android:id="@+id/btn_delete"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="6dp"
                android:src="@drawable/ic_delete"
                app:tint="#66FFFFFF"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="删除台词" />

            <!-- 全屏提词板按钮 -->
            <ImageView
                android:id="@+id/btn_board"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_segmented_capsule"
                android:padding="6dp"
                android:src="@drawable/ic_fullscreen"
                app:tint="#99FFFFFF"
                android:contentDescription="全屏提词板" />

            <!-- 悬浮提词一键开播小药丸 -->
            <LinearLayout
                android:id="@+id/btn_float"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_accent_pill"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_play"
                    android:tint="#000000"
                    app:tint="#000000" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="悬浮开播"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
