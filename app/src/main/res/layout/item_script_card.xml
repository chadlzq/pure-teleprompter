<?xml version="1.0" encoding="utf-8"?>
<!-- 
    单条台词卡片 (item_script_card.xml)
    显示标题、预估时长、字数标签，点击右侧按钮直接一键悬浮开播
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#1A1C24"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#26FFFFFF"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="台词标题：如何克服面对镜头的恐惧感"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btn_launch_prompter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="很多人一打开相机就卡壳，眼神左右乱瞟，其实不是你表达能力差，而是你的视线没有锚点..."
            android:textColor="#80FFFFFF"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/btn_launch_prompter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />

        <!-- 标签区：时长与字数 -->
        <TextView
            android:id="@+id/tv_time_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tag_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="⏱ 约 45 秒"
            android:textColor="#38EF7D"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_preview" />

        <TextView
            android:id="@+id/tv_words_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tag_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="180 字"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/tv_time_tag"
            app:layout_constraintStart_toEndOf="@id/tv_time_tag"
            app:layout_constraintTop_toTopOf="@id/tv_time_tag" />

        <!-- 一键悬浮提词按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_launch_prompter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="12dp"
            app:backgroundTint="#2A2D3A"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
