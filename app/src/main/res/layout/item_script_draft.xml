<?xml version="1.0" encoding="utf-8"?>
<!-- 
    极简精美台词卡片 (item_script_draft.xml)
    微交互安全升级版：
    1. 【防误触安全设计】：删除按键从底部移至卡片右上角，并用醒目警示红 (#FF5252) 标明，彻底杜绝开播时误触删除
    2. 【时间位置优化】：更新时间精准置于“约多少分多少秒”标签正上方，层次清晰
    3. 【紧凑精致布局】：右下角仅保留全屏与悬浮两枚核心开播按键
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_script_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#1A1C24"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#26FFFFFF"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- 标题 (左侧加粗白字) -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="台词标题"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btn_delete"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 删除按钮 (安全置于右上角，图标醒目红色，彻底防误触) -->
        <ImageView
            android:id="@+id/btn_delete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="5dp"
            android:src="@drawable/ic_delete"
            app:tint="#FF5252"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="删除台词"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 2行台词正文精要 (去繁化简) -->
        <TextView
            android:id="@+id/tv_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:text="台词正文摘要预览，最多显示两行内容..."
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />

        <!-- 底部左侧信息区：仅保留更新时间，界面纯粹极简 -->
        <LinearLayout
            android:id="@+id/ll_left_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/ll_actions"
            app:layout_constraintEnd_toStartOf="@id/ll_actions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/ll_actions">

            <!-- 时间日期 -->
            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="2024.04.12 15:30"
                android:textColor="#66FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 底部右侧：仅保留全屏开播、悬浮开播两项核心高频操作，零误触 -->
        <LinearLayout
            android:id="@+id/ll_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tv_preview"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 全屏提词板按钮 -->
            <ImageView
                android:id="@+id/btn_board"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_segmented_capsule"
                android:padding="6dp"
                android:src="@drawable/ic_fullscreen"
                app:tint="#99FFFFFF"
                android:contentDescription="全屏提词板" />

            <!-- 悬浮提词一键开播小药丸 -->
            <LinearLayout
                android:id="@+id/btn_float"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_accent_pill"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_play"
                    android:tint="#000000"
                    app:tint="#000000" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="悬浮开播"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
