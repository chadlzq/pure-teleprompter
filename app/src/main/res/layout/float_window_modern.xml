<?xml version="1.0" encoding="utf-8"?>
<!-- 
    极致纯净版：现代悬浮提词器 (float_window_modern.xml)
    融合原生顶级微交互体系：
    1. 【顶部专设拖动手柄】：顶部独立把手区域，杜绝手势移动窗口与文字上下滚屏冲突
    2. 【右下角无感缩放拉伸把手】：随时拖动右下角角标自由调节浮窗宽高尺寸
    3. 【一键最小化贴边悬浮球】：录制准备时一键折叠为48dp晶体小圆球，随时轻触展开
    4. 【纯净居中视线标线】：正居中无文字干扰黄金参考线
    5. 【纯图标去文字操作】：左/中/右对齐、重置、播放全部使用扁平高对比度图标
-->
<FrameLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/float_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- 1. 展开态：提词器主视窗卡片 (默认 320dp x 240dp，可通过右下角把手自由拉伸) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/prompter_card_container"
        android:layout_width="320dp"
        android:layout_height="240dp"
        android:background="@drawable/bg_modern_prompter_glass"
        android:padding="8dp">

        <!-- 顶部拖拽把手区 (Top Drag Header) -->
        <LinearLayout
            android:id="@+id/header_drag_area"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 左上角退出关闭按钮 (纯净小图标) -->
            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="退出" />

            <!-- 中间拖动指示条 (长条形药丸手柄，用户按住即可自由移动浮窗) -->
            <LinearLayout
                android:id="@+id/drag_handle_touch_wrapper"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/drag_handle_pill"
                    android:layout_width="44dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_drag_handle_pill" />
            </LinearLayout>

            <!-- 一键复位窗口尺寸与位置按钮 (防变形防迷失) -->
            <ImageView
                android:id="@+id/btn_reset_window"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:padding="6dp"
                android:src="@drawable/ic_reset"
                app:tint="#80FFFFFF"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="复位默认大小与居中" />

            <!-- 最小化为悬浮球按钮 -->
            <ImageView
                android:id="@+id/btn_minimize"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="6dp"
                android:src="@drawable/ic_minimize"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="最小化收起" />
        </LinearLayout>

        <!-- 纯净对焦参考线 (正居中，半透明翠绿极细线) -->
        <View
            android:id="@+id/focal_line"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#3338EF7D"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/text_scroll_view"
            app:layout_constraintBottom_toBottomOf="@id/text_scroll_view" />

        <!-- 核心文字平滑滚动区 (原生物理拖拽与自动匀速平滑滚屏) -->
        <com.teleprompter.pure.ui.SmoothTextScrollView
            android:id="@+id/text_scroll_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintTop_toBottomOf="@id/header_drag_area"
            app:layout_constraintBottom_toTopOf="@id/bottom_control_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 3-2-1 启动倒计时大字居中覆盖层 -->
        <TextView
            android:id="@+id/tv_countdown_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="56sp"
            android:textColor="#38EF7D"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/text_scroll_view"
            app:layout_constraintBottom_toBottomOf="@id/text_scroll_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 底部控制栏：纯图标胶囊组 (宽度自适应，绝不挤压右侧拉伸角标) -->
        <LinearLayout
            android:id="@+id/bottom_control_bar"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_scale_corner">

            <!-- 纯图标三段式对齐胶囊 (左对齐 | 居中 | 右对齐) -->
            <LinearLayout
                android:id="@+id/layout_align_toggle"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_segmented_capsule"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/tab_align_left"
                    android:layout_width="26dp"
                    android:layout_height="match_parent"
                    android:padding="5dp"
                    android:src="@drawable/ic_format_align_left"
                    app:tint="#80FFFFFF"
                    android:contentDescription="左对齐" />

                <ImageView
                    android:id="@+id/tab_align_center"
                    android:layout_width="26dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_segment_active_pill"
                    android:padding="5dp"
                    android:src="@drawable/ic_format_align_center"
                    app:tint="#FFFFFF"
                    android:contentDescription="居中对齐" />

                <ImageView
                    android:id="@+id/tab_align_right"
                    android:layout_width="26dp"
                    android:layout_height="match_parent"
                    android:padding="5dp"
                    android:src="@drawable/ic_format_align_right"
                    app:tint="#80FFFFFF"
                    android:contentDescription="右对齐" />
            </LinearLayout>

            <!-- 弹性空间 -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 左右镜像翻转按键 (纯图标 🪞，分光镜与自拍镜像必备) -->
            <ImageView
                android:id="@+id/btn_mirror"
                android:layout_width="30dp"
                android:layout_height="28dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_segmented_capsule"
                android:padding="6dp"
                android:src="@drawable/ic_mirror"
                app:tint="#FFFFFF"
                android:contentDescription="左右镜像翻转" />

            <!-- 一键重置首句按键 (纯图标 ↺) -->
            <ImageView
                android:id="@+id/btn_reset"
                android:layout_width="30dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_segmented_capsule"
                android:padding="6dp"
                android:src="@drawable/ic_reset"
                app:tint="#FFFFFF"
                android:contentDescription="回到首句" />

            <!-- 播放/暂停按键 (纯图标 ▶ / ⏸) -->
            <ImageView
                android:id="@+id/btn_play_pause"
                android:layout_width="38dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_btn_accent_pill"
                android:padding="6dp"
                android:src="@drawable/ic_play"
                android:tint="#000000"
                app:tint="#000000"
                android:contentDescription="播放与暂停" />
        </LinearLayout>

        <!-- 右下角缩放拉伸角标 (Corner Resize Grip，直接固定在卡片右下角，大触控区，绝不隐藏) -->
        <ImageView
            android:id="@+id/btn_scale_corner"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_scale_corner"
            app:tint="#B3FFFFFF"
            android:contentDescription="拖拽拉伸窗口尺寸"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. 收起态：迷你贴边悬浮球 (48dp 晶体圆球，默认隐藏) -->
    <LinearLayout
        android:id="@+id/float_ball_container"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_float_ball"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_float_ball"
            android:contentDescription="展开悬浮提词器" />
    </LinearLayout>

</FrameLayout>
