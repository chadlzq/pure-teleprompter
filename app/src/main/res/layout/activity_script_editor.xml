<?xml version="1.0" encoding="utf-8"?>
<!-- 
    全新设计：极简口播台词编辑器 (activity_script_editor.xml)
    特色：自动保存、实时字数预估、一键剪贴板粘贴、TXT文档导入、全屏/悬浮双模式提词
-->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1015">

    <!-- 顶部导航栏 -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回" />

        <!-- 标题输入框 (单行极简) -->
        <EditText
            android:id="@+id/et_script_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toEndOf="@id/btn_back"
            android:layout_toStartOf="@id/actions_launch_group"
            android:layout_marginHorizontal="8dp"
            android:background="@null"
            android:hint="输入脚本标题 (选填)"
            android:textColorHint="#66FFFFFF"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:maxLines="1" />

        <!-- 启动操作按钮组 (全屏提词板 / 开启悬浮窗) -->
        <LinearLayout
            android:id="@+id/actions_launch_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_launch_board"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_segmented_capsule"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="全屏板"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_launch_prompter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_btn_accent_pill"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="开启悬浮"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 分割指示细线 -->
    <View
        android:id="@+id/divider_top"
        android:layout_width="match_parent"
        android:layout_height="0.8dp"
        android:background="#1AFFFFFF"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <!-- 快捷工具与数据看板条 -->
    <LinearLayout
        android:id="@+id/toolbar_stats"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/divider_top">

        <!-- 实时字数与耗时看板胶囊 (根据普通人语速 4字/秒换算) -->
        <TextView
            android:id="@+id/tv_stats_chip"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_segmented_capsule"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="0 字 · 预估 0 秒"
            android:textColor="#38EF7D"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 【新增】：一键导入 TXT 文件 -->
        <TextView
            android:id="@+id/btn_import_txt"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_segmented_capsule"
            android:gravity="center"
            android:paddingHorizontal="9dp"
            android:text="📂 导入TXT"
            android:textColor="#E0E0E0"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- 一键从剪贴板粘贴按钮 -->
        <LinearLayout
            android:id="@+id/btn_paste_clipboard"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_segmented_capsule"
            android:gravity="center"
            android:paddingHorizontal="9dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_clipboard_paste"
                android:layout_marginEnd="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="粘贴"
                android:textColor="#E0E0E0"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 一键清空按钮 -->
        <TextView
            android:id="@+id/btn_clear_content"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_segmented_capsule"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="清空"
            android:textColor="#9E9E9E"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 主台词多行正文输入区 (带平滑滚动) -->
    <ScrollView
        android:id="@+id/scroll_editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@id/bottom_save_status_bar"
        app:layout_constraintTop_toBottomOf="@id/toolbar_stats">

        <EditText
            android:id="@+id/et_script_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="top|start"
            android:hint="在此输入或粘贴您的口播台词内容...\n\n支持自动分段与标点，编辑过程会自动实时保存至本地数据库，无需担心丢失。"
            android:lineSpacingExtra="6dp"
            android:lineSpacingMultiplier="1.3"
            android:paddingHorizontal="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="40dp"
            android:textColor="#F5F5F5"
            android:textColorHint="#4DFFFFFF"
            android:textSize="17sp" />
    </ScrollView>

    <!-- 底部状态指示栏 -->
    <LinearLayout
        android:id="@+id/bottom_save_status_bar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#14161F"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:id="@+id/dot_save_status"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_btn_accent_pill" />

        <TextView
            android:id="@+id/tv_save_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="本地数据库已同步 (自动保存)"
            android:textColor="#80FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
