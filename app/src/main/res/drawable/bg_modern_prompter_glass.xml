<?xml version="1.0" encoding="utf-8"?>
<!-- 磨砂质感深空灰大圆角悬浮背景 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 80% 不透明度的深空灰底色 -->
    <solid android:color="#CC12141A" />
    <corners android:radius="20dp" />
    <!-- 极细腻的高光微边框，凸显高级感 -->
    <stroke
        android:width="1.2dp"
        android:color="#33FFFFFF" />
</shape>
