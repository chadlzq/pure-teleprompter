<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 悬浮窗显示权限 (核心权限) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- 100% 纯本地运行，不申请任何联网权限、设备识别码、位置等高危权限，100% 免除工信部隐私合规审查风险 -->

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TeleprompterPure">

        <!-- 应用主入口：我的台词草稿箱 (ScriptManagerActivity) -->
        <activity
            android:name=".ui.ScriptManagerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 台词编辑器 (ScriptEditorActivity) -->
        <activity
            android:name=".ui.ScriptEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 提词偏好设置 (SettingsActivity) -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <!-- 全屏演播室提词板 (PromptBoardActivity) -->
        <activity
            android:name=".ui.PromptBoardActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|keyboardHidden" />

    </application>

</manifest>
